{
  "about": "The apps' own repositories at the commits the Arena takes them from (kanban #569, #575): bitcoin-arena tracks no app. tools/fetch-apps.mjs checks the listed paths out into .apps/<name> and places each app at `copy` (not tracked; Next Block without its Unity project, which only its own repository holds); arena-client's apps-pinned test checks every placed app against its checkout, and apps.files.json (tools/pin-apps.mjs) names the files a node downloads of each.",
  "apps": {
    "arena-app-next-block": {
      "repo": "bitcoin-arena/arena-app-next-block",
      "commit": "11069e25997af0c1b0b4c7b886569c60250b33eb",
      "paths": [
        "/*",
        "!/unity/",
        "/unity/Assets/Plugins/",
        "/unity/Assets/Scripts/",
        "/unity/Assets/Tests/",
        "/unity/ProjectSettings/",
        "/unity/Assets/Models/bitcoin_miner_megastructure.glb",
        "/unity/Assets/Art/Resources/"
      ],
      "copy": "packages/nextblock"
    },
    "arena-app-hello-world": {
      "repo": "george-prime/arena-app-hello-world",
      "commit": "2453b935baefac694b2274e6bc17bce26aae43eb",
      "copy": "packages/hello-world",
      "paths": [
        "/*"
      ]
    },
    "arena-app-rock-paper-scissors": {
      "repo": "bitcoin-arena/arena-app-rock-paper-scissors",
      "commit": "9b1f72a983fe2aec821d09efa1f89316fcd7ccb9",
      "copy": "packages/rock-paper-scissors",
      "paths": [
        "/*"
      ]
    },
    "arena-app-up-or-down": {
      "repo": "bitcoin-arena/arena-app-up-or-down",
      "commit": "1f14b89f6861763146fb55690ab93d89f5ebcd1f",
      "copy": "packages/btc-updown",
      "paths": [
        "/*"
      ]
    }
  }
}
